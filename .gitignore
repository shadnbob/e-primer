# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build output
# NOTE: dist/ and dist-firefox/ are intentionally committed (README offers
# install-without-building), so they are NOT ignored here — an ignore entry
# would make `git add` silently skip newly built files inside them.
build/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache
.npm/
.eslintcache
.cache/

# Logs
logs/
*.log

# IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
.directory
Thumbs.db

# Testing
coverage/

# Temporary files
tmp/
temp/
*.zip
/.claude/settings.local.json
